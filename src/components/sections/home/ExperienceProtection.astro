---
import { experienceProtectionProofs } from "../../../data/home";
import type { Lang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="over-25-years-of-roofing-experience"
  class="experience-protection"
  aria-labelledby="over-25-years-of-roofing-experience-title"
  data-ui-id="home.experience-protection"
>
  <div class="experience-container">
    <div class="experience-copy">
      <p class="section-eyebrow">{t("experience.eyebrow")}</p>
      <h2 id="over-25-years-of-roofing-experience-title">
        {t("experience.title")}
      </h2>
      <p class="section-body">{t("experience.body")}</p>
    </div>

    <div class="experience-stats" aria-label={t("experience.eyebrow")}>
      <div class="experience-stat experience-stat--years">
        <strong>{t("experience.years.value")}</strong>
        <span>{t("experience.years.label")}</span>
      </div>
      <div class="experience-stat experience-stat--quality">
        <strong>{t("experience.quality.value")}</strong>
        <span>{t("experience.quality.label")}</span>
      </div>
    </div>

    <div class="protection-list">
      {
        experienceProtectionProofs.map((proof) => (
          <article
            class:list={["protection-card", `protection-card--${proof.size}`]}
          >
            <span class="proof-icon" aria-hidden="true">
              ✓
            </span>
            <h3>{t(proof.titleKey)}</h3>
            <p>{t(proof.bodyKey)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experience-protection {
    min-height: 72.5rem;
    color: var(--color-on-dark);
    background: var(--color-ink-950);
  }

  .experience-container {
    position: relative;
    width: 100%;
    max-width: 22.5rem;
    min-height: 72.5rem;
    padding: 2.8125rem 1.25rem 0;
    margin-inline: auto;
  }

  .section-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.034375rem;
    color: var(--color-brand-orange);
  }

  h2 {
    max-width: 20rem;
    margin: 0.975rem 0 0;
    font-size: 1.9375rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-on-dark);
  }

  .section-body {
    max-width: 19.875rem;
    margin: 0.7rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.48;
    color: var(--color-text-on-dark-muted);
  }

  .experience-stats {
    position: absolute;
    top: 22.1875rem;
    left: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 9.625rem);
    gap: 0.75rem;
  }

  .experience-stat {
    display: flex;
    height: 6.875rem;
    padding: 0.9375rem 1rem;
    flex-direction: column;
    border-radius: var(--radius-card);
  }

  .experience-stat strong {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.1;
  }

  .experience-stat span {
    max-width: 7.625rem;
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 900;
    line-height: 1.18;
  }

  .experience-stat--years {
    background: var(--color-action);
  }

  .experience-stat--quality {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .experience-stat--quality strong {
    color: var(--color-brand-blue);
  }

  .protection-list {
    position: absolute;
    top: 31.875rem;
    left: 1.25rem;
    display: grid;
    width: 20rem;
    gap: 1.875rem;
  }

  .protection-card {
    position: relative;
    height: 10rem;
    padding: 4.375rem 1.25rem 0;
    color: var(--color-text);
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .protection-card--tall {
    height: 12.5rem;
  }

  .proof-icon {
    position: absolute;
    top: 0.875rem;
    left: 1.25rem;
    display: grid;
    width: 2.625rem;
    height: 2.625rem;
    place-items: center;
    font-size: 1.125rem;
    font-weight: 900;
    color: var(--color-brand-orange);
    background: var(--color-brand-blue-soft);
    border-radius: var(--radius-button);
  }

  .protection-card h3 {
    max-width: 16.875rem;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-blue);
  }

  .protection-card p {
    position: absolute;
    top: 6.25rem;
    left: 1.25rem;
    max-width: 16.875rem;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
  }

  .protection-card--tall p {
    top: 7.8125rem;
  }

  @media (min-width: 81rem) {
    .experience-protection {
      min-height: 43.75rem;
    }

    .experience-container {
      max-width: 80rem;
      min-height: 43.75rem;
      padding: 5.625rem 0 0;
    }

    .experience-copy {
      width: 33.125rem;
    }

    .section-eyebrow {
      font-size: 0.8125rem;
      letter-spacing: 0;
    }

    h2 {
      max-width: 33.125rem;
      margin-top: 1.525rem;
      font-size: 2.625rem;
    }

    .section-body {
      max-width: 33.125rem;
      margin-top: 1.8rem;
      font-size: 1rem;
      line-height: 1.55;
    }

    .experience-stats {
      top: 27.875rem;
      left: 0;
      grid-template-columns: repeat(2, 15.625rem);
      gap: 1.25rem;
    }

    .experience-stat {
      height: 8.125rem;
      padding: 1.375rem 2rem;
    }

    .experience-stat strong {
      font-size: 3rem;
    }

    .experience-stat--quality strong {
      font-size: 3rem;
    }

    .experience-stat span {
      max-width: none;
      margin-top: 0.25rem;
      font-size: 0.9375rem;
    }

    .protection-list {
      top: 6.5625rem;
      left: 44.0625rem;
      width: 32.5rem;
      gap: 2.125rem;
    }

    .protection-card {
      height: 7.625rem;
      padding: 1.5625rem 1.875rem 0 6.875rem;
    }

    .protection-card--tall {
      height: 9.8125rem;
    }

    .protection-card:last-child {
      margin-top: 0.125rem;
    }

    .proof-icon {
      top: 1.6875rem;
      left: 1.6875rem;
      width: 3.375rem;
      height: 3.375rem;
      font-size: 1.25rem;
    }

    .protection-card h3 {
      max-width: 21.875rem;
      font-size: 1.375rem;
      line-height: 1.1;
    }

    .protection-card p,
    .protection-card--tall p {
      position: static;
      max-width: 22.5rem;
      margin-top: 0.625rem;
      font-size: 0.8125rem;
    }
  }
</style>
