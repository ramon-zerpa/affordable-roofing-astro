---
import { Image } from "astro:assets";
import residentialInstallation from "../../../assets/images/home/residential-installation.jpeg";
import residentialRepair from "../../../assets/images/home/residential-repair.jpg";
import { residentialBenefits } from "../../../data/home";
import { site } from "../../../data/site";
import type { Lang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="residential-roofing-tampa"
  class="residential-roofing"
  aria-labelledby="residential-roofing-tampa-title"
  data-ui-id="home.residential-roofing-tampa"
>
  <div class="residential-container">
    <div class="residential-visual">
      <Image
        class="residential-main-image"
        src={residentialInstallation}
        width={520}
        height={380}
        alt={t("residential.imageAlt")}
        loading="lazy"
        decoding="async"
      />
      <Image
        class="residential-accent-image"
        src={residentialRepair}
        width={260}
        height={200}
        alt={t("residential.accentAlt")}
        loading="lazy"
        decoding="async"
      />
      <div class="residential-stat">
        <strong>{t("residential.statValue")}</strong>
        <span>{t("residential.statLabel")}</span>
      </div>
    </div>

    <div class="residential-content">
      <p class="section-eyebrow">{t("residential.eyebrow")}</p>
      <h2 id="residential-roofing-tampa-title">{t("residential.title")}</h2>
      <p class="residential-intro">{t("residential.intro")}</p>
      <p class="residential-support">{t("residential.support")}</p>

      <ul
        class="residential-benefits"
        aria-label="Residential roofing benefits"
      >
        {
          residentialBenefits.map((benefit) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3.2 8.2 2.7 2.7 6-6" />
              </svg>
              <span>{t(benefit)}</span>
            </li>
          ))
        }
      </ul>

      <a class="residential-cta" href={site.estimateHref}>
        {t("site.estimate")}
      </a>
    </div>
  </div>
</section>

<style>
  .residential-roofing {
    min-height: 56.875rem;
    background: var(--color-surface);
  }

  .residential-container {
    width: 100%;
    max-width: 22.5rem;
    padding: 2.25rem 1.25rem 2.625rem;
    margin-inline: auto;
  }

  .residential-visual {
    position: relative;
    width: 20rem;
    height: 15.875rem;
  }

  .residential-main-image {
    width: 20rem;
    height: 13.625rem;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .residential-accent-image {
    display: none;
  }

  .residential-stat {
    position: absolute;
    top: 11.375rem;
    right: 1rem;
    display: flex;
    width: 10.625rem;
    height: 4.5rem;
    padding: 0.25rem 0.875rem 0.5rem;
    flex-direction: column;
    color: var(--color-on-dark);
    background: var(--color-brand-navy);
    border-radius: var(--radius-button);
  }

  .residential-stat strong {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 900;
    line-height: 1.35;
  }

  .residential-stat span {
    margin-top: 0.26875rem;
    font-size: 0.5625rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .residential-content {
    margin-top: 1.5625rem;
  }

  .section-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.034375rem;
    color: var(--color-action);
  }

  h2 {
    max-width: 20rem;
    margin: 0.65rem 0 0;
    font-size: 1.9375rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-blue);
  }

  .residential-intro,
  .residential-support {
    width: 100%;
    max-width: 19.875rem;
    margin-inline: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.48;
    color: var(--color-text);
  }

  .residential-intro {
    margin-top: 0.8125rem;
    margin-bottom: 0;
  }

  .residential-support {
    margin-top: 0.9375rem;
    margin-bottom: 0;
  }

  .residential-benefits {
    display: grid;
    grid-template-columns: 9rem 10.25rem;
    gap: 0.75rem;
    padding: 0;
    margin: 2rem 0 0;
    list-style: none;
  }

  .residential-benefits li {
    display: flex;
    height: 2.375rem;
    padding-inline: 0.75rem;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-brand-blue);
    background: var(--color-brand-blue-soft);
    border-radius: var(--radius-button);
  }

  .residential-benefits svg {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--color-brand-orange);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .residential-benefits li:last-child {
    font-size: 0.6875rem;
  }

  .residential-cta {
    display: inline-flex;
    min-width: 12.125rem;
    min-height: 3rem;
    margin-top: 2.3125rem;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 900;
    color: var(--color-on-dark);
    text-decoration: none;
    background: var(--color-action);
    border-radius: var(--radius-button);
  }

  .residential-cta:hover,
  .residential-cta:focus-visible {
    background: var(--color-action-hover);
  }

  @media (min-width: 64rem) {
    .residential-roofing {
      min-height: 39.375rem;
    }

    .residential-container {
      display: grid;
      grid-template-columns: 35.5rem 37rem;
      gap: 6.25rem;
      max-width: 80rem;
      padding: 0;
    }

    .residential-content {
      grid-column: 1;
      grid-row: 1;
      margin-top: 4.375rem;
    }

    .residential-visual {
      grid-column: 2;
      grid-row: 1;
      width: 37rem;
      height: 27.1875rem;
      margin-top: 6.25rem;
    }

    .residential-main-image {
      position: absolute;
      top: 0;
      right: 0;
      width: 32.5rem;
      height: 23.75rem;
    }

    .residential-accent-image {
      position: absolute;
      bottom: 0;
      left: 0;
      display: block;
      width: 16.25rem;
      height: 12.5rem;
      object-fit: cover;
      border: 0.375rem solid var(--color-surface);
      border-radius: var(--radius-card);
    }

    .residential-stat {
      top: 18.75rem;
      right: 1.25rem;
      width: 16.25rem;
      height: 8.125rem;
      padding: 0.9375rem 1.875rem 0.75rem;
    }

    .residential-stat strong {
      font-size: 1.75rem;
    }

    .residential-stat span {
      margin-top: 0.7625rem;
      font-size: 0.8125rem;
      font-weight: 600;
      line-height: 1.35;
    }

    .section-eyebrow {
      font-size: 0.8125rem;
      letter-spacing: 0;
    }

    h2 {
      max-width: 34.375rem;
      margin-top: 0.9rem;
      font-size: 2.6875rem;
    }

    .residential-intro,
    .residential-support {
      max-width: 35.625rem;
      font-size: 1rem;
      line-height: 1.6;
    }

    .residential-intro {
      margin-top: 1.475rem;
    }

    .residential-support {
      margin-top: 1.725rem;
    }

    .residential-benefits {
      grid-template-columns: 7.625rem 7.875rem 7.25rem 10.25rem;
      gap: 0.75rem;
      margin-top: 2.325rem;
    }

    .residential-benefits li {
      height: 2.625rem;
      padding: 0;
      justify-content: center;
      font-size: 0.8125rem;
    }

    .residential-benefits svg {
      display: none;
    }

    .residential-benefits li:last-child {
      font-size: 0.8125rem;
    }

    .residential-cta {
      min-width: 11.875rem;
      min-height: 3.25rem;
      margin-top: 2.75rem;
    }
  }
</style>
