---
import { Image } from "astro:assets";
import architecturalShingles from "../../../assets/images/home/architectural-shingles.jpg";
import certainteedLogo from "../../../assets/images/home/certainteed-logo.png";
import timberlineLogo from "../../../assets/images/home/timberline-hdz-logo.png";
import { shingleManufacturers } from "../../../data/home";
import type { Lang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const logos = {
  timberline: timberlineLogo,
  certainteed: certainteedLogo,
};
---

<section
  id="architectural-shingle-roofing"
  class="shingle-roofing"
  aria-labelledby="architectural-shingle-roofing-title"
  data-ui-id="home.architectural-shingle-roofing"
>
  <div class="shingle-container">
    <div class="shingle-intro">
      <p class="section-eyebrow">{t("shingles.eyebrow")}</p>
      <h2 id="architectural-shingle-roofing-title">{t("shingles.title")}</h2>
      <p class="section-body">{t("shingles.intro")}</p>

      <div class="shingle-visual">
        <Image
          class="shingle-image"
          src={architecturalShingles}
          width={550}
          height={300}
          alt={t("shingles.imageAlt")}
          loading="lazy"
          decoding="async"
        />
        <p class="shingle-products">{t("shingles.products")}</p>
      </div>
    </div>

    <div class="manufacturer-grid">
      {
        shingleManufacturers.map((manufacturer) => (
          <article class="manufacturer-card">
            <Image
              class:list={[
                "manufacturer-logo",
                `manufacturer-logo--${manufacturer.logo}`,
              ]}
              src={logos[manufacturer.logo]}
              width={280}
              height={40}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <h3>{t(manufacturer.titleKey)}</h3>
            <p>{t(manufacturer.bodyKey)}</p>
            <a href={manufacturer.href}>{t(manufacturer.linkKey)}</a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .shingle-roofing {
    min-height: 75rem;
    background: var(--color-surface-muted);
  }

  .shingle-container {
    width: 100%;
    max-width: 22.5rem;
    padding: 2.75rem 1.25rem 4.0625rem;
    margin-inline: auto;
  }

  .section-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.034375rem;
    color: var(--color-action);
  }

  h2 {
    max-width: 20rem;
    margin: 0.475rem 0 0;
    font-size: 1.9375rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-blue);
  }

  .section-body {
    width: 100%;
    max-width: 19.875rem;
    margin: 0.5625rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.48;
    color: var(--color-text);
  }

  .shingle-visual {
    position: relative;
    width: 20rem;
    height: 16.0625rem;
    margin-top: 2.125rem;
  }

  .shingle-image {
    width: 20rem;
    height: 11.375rem;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .shingle-products {
    position: absolute;
    top: 10.625rem;
    left: 0;
    width: 20rem;
    min-height: 5.4375rem;
    padding: 1.0625rem;
    margin: 0;
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.4;
    color: var(--color-brand-blue);
    background: var(--color-brand-blue-soft);
    border-radius: var(--radius-card);
  }

  .manufacturer-grid {
    display: grid;
    gap: 2.1875rem;
    margin-top: 2.0625rem;
  }

  .manufacturer-card {
    min-height: 16.5625rem;
    padding: 1.0625rem 1.1875rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .manufacturer-card:last-child {
    min-height: 15.3125rem;
  }

  .manufacturer-logo {
    width: 11.25rem;
    height: 2.5rem;
    object-fit: contain;
    object-position: left center;
    margin-left: -0.125rem;
  }

  .manufacturer-card h3 {
    max-width: 16.875rem;
    margin: 0.75rem 0 0;
    font-family: var(--font-heading);
    font-size: 1.3125rem;
    font-weight: 800;
    line-height: 1.12;
    color: var(--color-brand-blue);
  }

  .manufacturer-card p {
    max-width: 17.5rem;
    margin: 0.8125rem 0 0;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.42;
    color: var(--color-text);
  }

  .manufacturer-card a {
    display: none;
  }

  @media (min-width: 81rem) {
    .shingle-roofing {
      min-height: 44.375rem;
    }

    .shingle-container {
      display: grid;
      grid-template-columns: 34.375rem 31.25rem;
      gap: 7.5rem;
      max-width: 73.125rem;
      padding: 0;
    }

    .shingle-intro {
      margin-top: 3.8125rem;
    }

    .section-eyebrow {
      font-size: 0.8125rem;
      letter-spacing: 0;
    }

    h2 {
      max-width: 35rem;
      margin-top: 0.9rem;
      font-size: 2.5rem;
    }

    .section-body {
      max-width: 34.375rem;
      margin-top: 1.1625rem;
      font-size: 1rem;
      line-height: 1.55;
    }

    .shingle-visual {
      width: 34.375rem;
      height: 18.75rem;
      margin-top: 2.2375rem;
    }

    .shingle-image {
      width: 34.375rem;
      height: 18.75rem;
    }

    .shingle-products {
      top: 14.6875rem;
      left: 5.9375rem;
      width: 27.5rem;
      min-height: 3.125rem;
      padding: 0.5rem 0.8125rem;
      font-size: 0.8125rem;
      line-height: 1.35;
    }

    .manufacturer-grid {
      gap: 2.1875rem;
      margin-top: 4.375rem;
    }

    .manufacturer-card {
      height: 17.5rem;
      min-height: 0;
      padding: 1.8125rem 2.125rem;
    }

    .manufacturer-card:last-child {
      height: 15.625rem;
      min-height: 0;
    }

    .manufacturer-logo {
      width: 17.5rem;
      height: 2.5rem;
      margin-left: -0.3125rem;
    }

    .manufacturer-logo--certainteed {
      width: 11.5625rem;
    }

    .manufacturer-card h3 {
      max-width: 26.5625rem;
      margin-top: 1.5625rem;
      font-size: 1.5rem;
    }

    .manufacturer-card:last-child h3 {
      margin-top: 0.9375rem;
    }

    .manufacturer-card p {
      max-width: 26.5625rem;
      margin-top: 0.82rem;
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .manufacturer-card a {
      display: inline-block;
      margin-top: 1.175rem;
      font-size: 0.8125rem;
      font-weight: 900;
      color: var(--color-action);
      text-decoration: none;
    }
  }
</style>
