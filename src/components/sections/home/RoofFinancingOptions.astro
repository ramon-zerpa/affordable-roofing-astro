---
import { financingFacts } from "../../../data/home";
import type { Lang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="we-offer-roof-financing-for-your-roofing-projects"
  class="roof-financing"
  aria-labelledby="we-offer-roof-financing-for-your-roofing-projects-title"
  data-ui-id="home.roof-financing-options"
>
  <div class="financing-panel">
    <div class="financing-copy">
      <div class="section-eyebrow">{t("financingDetails.eyebrow")}</div>
      <h2 id="we-offer-roof-financing-for-your-roofing-projects-title">
        {t("financingDetails.title")}
      </h2>
      <p class="section-body">{t("financingDetails.body")}</p>
      <a class="financing-cta" href="/financing/">
        {t("financingDetails.cta")}
      </a>
    </div>

    <div
      class="financing-facts"
      aria-label={t("financingDetails.factsLabel")}
      data-claim-id="hearth-financing-terms"
    >
      {
        financingFacts.map((fact) => (
          <article class="financing-fact">
            <strong>{t(fact.valueKey)}</strong>
            <span>{t(fact.labelKey)}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .roof-financing {
    min-height: 49.375rem;
    background: var(--color-brand-blue-soft);
  }

  .financing-panel {
    position: relative;
    width: 100%;
    max-width: 22.5rem;
    min-height: 49.375rem;
    margin-inline: auto;
  }

  .financing-copy {
    position: absolute;
    top: 3.125rem;
    left: 1.25rem;
    width: 20rem;
  }

  .section-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.034375rem;
    color: var(--color-brand-orange);
  }

  h2 {
    width: 20rem;
    margin: 0.6875rem 0 0;
    font-size: 1.875rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-blue);
  }

  .section-body {
    width: 19.375rem;
    margin: 0.8125rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.48;
    color: var(--color-text);
  }

  .financing-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10.875rem;
    min-height: 3rem;
    margin-top: 2.4375rem;
    font-size: 0.875rem;
    font-weight: 900;
    color: var(--color-on-dark);
    text-decoration: none;
    background: var(--color-action);
    border-radius: var(--radius-button);
  }

  .financing-cta:hover,
  .financing-cta:focus-visible {
    background: var(--color-action-hover);
  }

  .financing-facts {
    position: absolute;
    top: 30.625rem;
    left: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 9.625rem);
    gap: 1.6875rem 0.75rem;
  }

  .financing-fact {
    display: flex;
    width: 9.625rem;
    height: 6.75rem;
    padding: 1.75rem 0.75rem 0;
    flex-direction: column;
    color: var(--color-on-dark);
    background: var(--color-brand-navy);
    border-radius: var(--radius-card);
  }

  .financing-fact strong {
    font-family: var(--font-heading);
    font-size: 1.3125rem;
    font-weight: 900;
    line-height: 1.08;
    white-space: nowrap;
  }

  .financing-fact span {
    margin-top: 0.6875rem;
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-text-on-dark-muted);
  }

  @media (min-width: 81rem) {
    .roof-financing {
      min-height: 33.125rem;
      padding-top: 4.375rem;
    }

    .financing-panel {
      max-width: 80rem;
      min-height: 23.75rem;
      background: var(--color-surface);
      border: 2px solid var(--color-brand-orange);
      border-radius: var(--radius-card);
    }

    .financing-copy {
      top: 2.375rem;
      left: 3rem;
      width: 35.625rem;
    }

    .section-eyebrow {
      font-size: 0.8125rem;
      letter-spacing: 0;
    }

    h2 {
      width: 31.875rem;
      margin-top: 1.2125rem;
      font-size: 2.25rem;
    }

    .section-body {
      width: 35.625rem;
      margin-top: 1.078125rem;
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    .financing-cta {
      width: 11.25rem;
      min-height: 3.125rem;
      margin-top: 1.875rem;
    }

    .financing-facts {
      top: 4rem;
      left: 46.1875rem;
      grid-template-columns: repeat(2, 13.125rem);
      gap: 1.5rem 1.875rem;
    }

    .financing-fact {
      width: 13.125rem;
      height: 7rem;
      padding: 1.5rem 0 0 1.5rem;
    }

    .financing-fact strong {
      font-size: 1.6875rem;
    }

    .financing-fact span {
      margin-top: 0.5rem;
      font-size: 0.8125rem;
    }
  }
</style>
