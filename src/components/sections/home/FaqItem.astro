---
interface Props {
  id: string;
  question: string;
  answer: string;
  defaultOpen: boolean;
  mobileOrder: number;
}

const { id, question, answer, defaultOpen, mobileOrder } = Astro.props;
---

<details
  id={`faq-${id}`}
  class:list={["faq-item", `faq-order-${mobileOrder}`]}
  open={defaultOpen}
>
  <summary>
    <span class="faq-question">{question}</span>
    <span class="faq-toggle" aria-hidden="true"></span>
  </summary>
  <div class="faq-answer">
    <p>{answer}</p>
  </div>
</details>

<style>
  .faq-item {
    width: 100%;
    overflow: clip;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  summary {
    display: flex;
    min-height: 4.0625rem;
    padding: 0.875rem 1.125rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    max-width: 15.5rem;
    font-size: 0.875rem;
    font-weight: 900;
    line-height: 1.25;
    color: var(--color-brand-blue);
  }

  .faq-toggle {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 1.5rem;
    font-size: 1.375rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-brand-orange);
    place-items: center;
  }

  .faq-toggle::before {
    content: "+";
  }

  .faq-item[open] .faq-toggle::before {
    content: "−";
  }

  .faq-item[open] summary {
    min-height: 3.875rem;
    padding-top: 1.125rem;
    padding-bottom: 0.5rem;
    align-items: flex-start;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 1.125rem 1.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
  }

  @media (min-width: 64rem) {
    summary {
      min-height: 3.875rem;
      padding: 0.875rem 1.875rem;
    }

    .faq-question {
      max-width: 31.875rem;
      font-size: 0.9375rem;
    }

    .faq-item[open] summary {
      min-height: 3.125rem;
      padding-top: 1.25rem;
      padding-bottom: 0.375rem;
    }

    .faq-answer p {
      padding: 0 1.875rem 1.6875rem;
      font-size: 0.8125rem;
    }
  }
</style>
