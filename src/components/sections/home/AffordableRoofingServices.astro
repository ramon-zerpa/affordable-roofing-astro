---
import { Image } from "astro:assets";
import installationImage from "../../../assets/images/home/new-roof-installation.webp";
import repairImage from "../../../assets/images/home/roof-repair.webp";
import stormImage from "../../../assets/images/home/storm-damage.webp";
import { roofingServiceCards } from "../../../data/home";
import type { Lang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const serviceImages = {
  installation: installationImage,
  repair: repairImage,
  storm: stormImage,
} as const;
---

<section
  id="affordable-roofing-services"
  class="roofing-services"
  aria-labelledby="affordable-roofing-services-title"
  data-ui-id="home.affordable-roofing-services"
>
  <div class="services-container">
    <div class="services-copy">
      <div class="section-eyebrow">{t("roofingServices.eyebrow")}</div>
      <h2 id="affordable-roofing-services-title">
        {t("roofingServices.title")}
      </h2>
      <p class="section-body">{t("roofingServices.intro")}</p>
    </div>

    <div class="services-grid">
      {
        roofingServiceCards.map((service) => (
          <article
            class:list={["service-card", `service-card--${service.tone}`]}
          >
            <Image
              class="service-image"
              src={serviceImages[service.image]}
              width={400}
              height={210}
              alt={t(service.altKey)}
              loading="lazy"
              decoding="async"
            />
            <div class="service-content">
              <h3>{t(service.titleKey)}</h3>
              <p>{t(service.bodyKey)}</p>
              <a href={service.href}>{t("roofingServices.link")}</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .roofing-services {
    min-height: 93.75rem;
    background: var(--color-surface);
  }

  .services-container {
    position: relative;
    width: 100%;
    max-width: 22.5rem;
    min-height: 93.75rem;
    margin-inline: auto;
  }

  .services-copy {
    position: absolute;
    top: 3.125rem;
    left: 1.25rem;
    width: 20rem;
  }

  .section-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.034375rem;
    color: var(--color-brand-orange);
  }

  h2 {
    width: 20rem;
    margin: 0.6875rem 0 0;
    font-size: 1.9375rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-blue);
  }

  .section-body {
    width: 20rem;
    margin: 0.8125rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.48;
    color: var(--color-text);
  }

  .services-grid {
    position: absolute;
    top: 20rem;
    left: 1.25rem;
    display: grid;
    gap: 1.875rem;
  }

  .service-card {
    position: relative;
    width: 20rem;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-card);
    box-shadow:
      inset 0 0 0 1px var(--color-border),
      0 0.375rem 0.875rem rgb(0 0 0 / 6%);
  }

  .service-card:nth-child(1) {
    height: 21.875rem;
  }

  .service-card:nth-child(2) {
    height: 21.25rem;
  }

  .service-card:nth-child(3) {
    height: 23.4375rem;
  }

  .service-card--light {
    background: var(--color-surface-muted);
  }

  .service-card--dark {
    color: var(--color-on-dark);
    background: var(--color-brand-navy);
  }

  .service-image {
    width: 100%;
    height: 9.375rem;
    object-fit: cover;
  }

  .service-content {
    position: relative;
    height: calc(100% - 9.375rem);
    padding: 1.25rem;
  }

  .service-content h3 {
    width: 17.5rem;
    margin: 0;
    font-size: 1.4375rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-brand-blue);
  }

  .service-content p {
    width: 17.5rem;
    margin: 0.625rem 0 0;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.38;
    color: var(--color-text);
  }

  .service-content a {
    position: absolute;
    bottom: 1.375rem;
    left: 1.25rem;
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-brand-orange);
    text-decoration: none;
  }

  .service-content a:hover,
  .service-content a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .service-card--dark .service-content h3 {
    color: var(--color-on-dark);
  }

  .service-card--dark .service-content p {
    color: var(--color-text-on-dark-muted);
  }

  .service-card:nth-child(2) .service-content a {
    bottom: 1.6875rem;
  }

  @media (min-width: 81rem) {
    .roofing-services {
      min-height: 53.125rem;
    }

    .services-container {
      max-width: 80rem;
      min-height: 53.125rem;
    }

    .services-copy {
      top: 5rem;
      left: 0;
      width: 36.25rem;
    }

    .section-eyebrow {
      font-size: 0.8125rem;
      letter-spacing: 0;
    }

    h2 {
      width: 35rem;
      margin-top: 1.2125rem;
      font-size: 2.5rem;
    }

    .section-body {
      width: 36.25rem;
      margin-top: 1.0625rem;
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .services-grid {
      top: 20.625rem;
      left: 0;
      grid-template-columns: repeat(3, 25rem);
      gap: 2.5rem;
    }

    .service-card,
    .service-card:nth-child(1),
    .service-card:nth-child(2),
    .service-card:nth-child(3) {
      width: 25rem;
      height: 26.5625rem;
      box-shadow:
        inset 0 0 0 1px var(--color-border),
        0 0.5rem 1.125rem rgb(0 0 0 / 7%);
    }

    .service-image {
      width: 100%;
      height: 13.125rem;
    }

    .service-content {
      height: 13.4375rem;
      padding: 1.875rem;
    }

    .service-content h3 {
      width: 20rem;
      font-size: 1.5rem;
    }

    .service-content p {
      width: 18.75rem;
      margin-top: 0.875rem;
      font-size: 0.8125rem;
      line-height: 1.45;
    }

    .service-content a {
      bottom: 2rem;
      left: 1.875rem;
    }

    .service-card:nth-child(2) .service-content a {
      bottom: 2rem;
    }
  }
</style>
