---
import type { HomeFaqDefinition } from "../../../data/home";
import type { Lang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";
import FaqItem from "./FaqItem.astro";

export interface LocalizedHomeFaq extends HomeFaqDefinition {
  question: string;
  answer: string;
}

interface Props {
  lang: Lang;
  items: ReadonlyArray<LocalizedHomeFaq>;
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);
const leftItems = items.filter(({ desktopColumn }) => desktopColumn === "left");
const rightItems = items.filter(
  ({ desktopColumn }) => desktopColumn === "right",
);
---

<section
  id="roofing-faqs"
  class="roofing-faqs"
  aria-labelledby="roofing-faqs-title"
  data-ui-id="home.roofing-faqs"
>
  <div class="faq-columns">
    <div class="faq-column faq-column--left">
      <div class="faq-copy">
        <p class="section-eyebrow">{t("faqs.eyebrow")}</p>
        <h2 id="roofing-faqs-title">{t("faqs.title")}</h2>
        <p class="section-body">{t("faqs.intro")}</p>
      </div>

      <div class="faq-list">
        {
          leftItems.map((item) => (
            <FaqItem
              id={item.id}
              question={item.question}
              answer={item.answer}
              defaultOpen={item.defaultOpen}
              mobileOrder={items.indexOf(item)}
            />
          ))
        }
      </div>
    </div>

    <div class="faq-column faq-column--right">
      <div class="faq-list">
        {
          rightItems.map((item) => (
            <FaqItem
              id={item.id}
              question={item.question}
              answer={item.answer}
              defaultOpen={item.defaultOpen}
              mobileOrder={items.indexOf(item)}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .roofing-faqs {
    background: var(--color-surface-muted);
  }

  .faq-columns {
    display: flex;
    width: 100%;
    max-width: 22.5rem;
    min-height: 87.5rem;
    padding: 3.125rem 1.25rem 3.75rem;
    margin-inline: auto;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-column,
  .faq-list {
    display: contents;
  }

  .faq-copy {
    order: 0;
    margin-bottom: 0.9375rem;
  }

  .section-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.034375rem;
    color: var(--color-brand-orange);
  }

  h2 {
    width: 20rem;
    margin: 0.6875rem 0 0;
    font-size: 1.6875rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-blue);
    text-wrap: wrap;
  }

  .section-body {
    width: 20rem;
    margin: 0.9375rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.48;
    color: var(--color-text);
  }

  :global(.faq-order-0) {
    order: 1;
  }

  :global(.faq-order-1) {
    order: 2;
  }

  :global(.faq-order-2) {
    order: 3;
  }

  :global(.faq-order-3) {
    order: 4;
  }

  :global(.faq-order-4) {
    order: 5;
  }

  :global(.faq-order-5) {
    order: 6;
  }

  :global(.faq-order-6) {
    order: 7;
  }

  :global(.faq-order-7) {
    order: 8;
  }

  :global(.faq-order-8) {
    order: 9;
  }

  :global(.faq-order-9) {
    order: 10;
  }

  @media (min-width: 81rem) {
    .roofing-faqs {
      min-height: 53.75rem;
    }

    .faq-columns {
      display: grid;
      max-width: 80rem;
      min-height: 53.75rem;
      padding: 4.375rem 0 4.5rem;
      grid-template-columns: 37.5rem 38.75rem;
      gap: 3.125rem;
    }

    .faq-column {
      display: flex;
      min-width: 0;
      flex-direction: column;
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 1.4375rem;
    }

    .faq-copy {
      margin: 0;
      order: initial;
    }

    .section-eyebrow {
      font-size: 0.8125rem;
      letter-spacing: 0;
    }

    h2 {
      width: 30rem;
      margin-top: 0.9375rem;
      font-size: 2.5rem;
      line-height: 1.1;
    }

    .section-body {
      width: 34.375rem;
      margin-top: 1.125rem;
      font-size: 0.9375rem;
      line-height: 1.55;
    }

    .faq-column--left .faq-list {
      margin-top: 3.5rem;
    }

    .faq-column--right {
      padding-top: 1.875rem;
    }

    :global(.faq-item) {
      order: initial;
    }
  }
</style>
