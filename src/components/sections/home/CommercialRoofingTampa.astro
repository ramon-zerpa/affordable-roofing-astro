---
import { commercialRoofingPaths } from "../../../data/home";
import { site } from "../../../data/site";
import type { Lang } from "../../../i18n/ui";
import { useTranslations } from "../../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="commercial-roofing-tampa"
  class="commercial-roofing"
  aria-labelledby="commercial-roofing-tampa-title"
  data-ui-id="home.commercial-roofing-tampa"
>
  <div class="commercial-container">
    <div class="commercial-intro">
      <p class="section-eyebrow">{t("commercial.eyebrow")}</p>
      <h2 id="commercial-roofing-tampa-title">{t("commercial.title")}</h2>
      <p class="section-body">{t("commercial.intro")}</p>

      <div class="commercial-proof">
        <strong>{t("commercial.proof.title")}</strong>
        <span>{t("commercial.proof.body")}</span>
      </div>
    </div>

    <div class="commercial-actions">
      <div class="commercial-card-grid">
        {
          commercialRoofingPaths.map((path) => (
            <article
              class:list={["commercial-card", `commercial-card--${path.tone}`]}
            >
              <span class="commercial-icon" aria-hidden="true">
                {path.icon === "building" ? (
                  <svg viewBox="0 0 24 24">
                    <path d="M6 22V4c0-.55.45-1 1-1h10c.55 0 1 .45 1 1v18" />
                    <path d="M6 12H4c-.55 0-1 .45-1 1v9M18 9h2c.55 0 1 .45 1 1v12M10 7h4M10 11h4M10 15h4M10 19h4M3 22h18" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24">
                    <path d="M3 22V10l7 4v-4l7 4V6h4v16M3 22h18M7 18h.01M11 18h.01M15 18h.01" />
                  </svg>
                )}
              </span>
              <h3>{t(path.titleKey)}</h3>
              <p>{t(path.bodyKey)}</p>
              <a href={path.href}>
                {t(path.linkKey)}{" "}
                <span class="mobile-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </article>
          ))
        }
      </div>

      <a class="commercial-cta" href={site.estimateHref}>
        {t("commercial.cta")}
      </a>
    </div>
  </div>
</section>

<style>
  .commercial-roofing {
    min-height: 65rem;
    background: var(--color-surface-muted);
  }

  .commercial-container {
    width: 100%;
    max-width: 22.5rem;
    padding: 2.8125rem 1.25rem 3.25rem;
    margin-inline: auto;
  }

  .section-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.034375rem;
    color: var(--color-brand-orange);
  }

  h2 {
    max-width: 20rem;
    margin: 0.625rem 0 0;
    font-size: 1.9375rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-blue);
  }

  .section-body {
    max-width: 19.875rem;
    margin: 0.8125rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.48;
    color: var(--color-text);
  }

  .commercial-proof {
    min-height: 6.875rem;
    padding: 0.9375rem 1.125rem;
    margin-top: 1.625rem;
    background: var(--color-brand-blue-soft);
    border-radius: var(--radius-card);
  }

  .commercial-proof strong,
  .commercial-proof span {
    display: block;
  }

  .commercial-proof strong {
    font-family: var(--font-heading);
    font-size: 1.1875rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-brand-blue);
  }

  .commercial-proof span {
    margin-top: 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
  }

  .commercial-card-grid {
    display: grid;
    gap: 1.5625rem;
    margin-top: 1.875rem;
  }

  .commercial-card {
    position: relative;
    min-height: 13.4375rem;
    padding: 4.6875rem 1.125rem 1.125rem;
    color: var(--color-on-dark);
    border-radius: var(--radius-card);
  }

  .commercial-card--navy {
    background: var(--color-brand-navy);
  }

  .commercial-card--blue {
    background: var(--color-brand-blue);
  }

  .commercial-icon {
    position: absolute;
    top: 1.125rem;
    left: 1.125rem;
    display: grid;
    width: 2.625rem;
    height: 2.625rem;
    place-items: center;
    background: var(--color-surface);
    border-radius: var(--radius-button);
  }

  .commercial-icon svg {
    width: 1.4375rem;
    height: 1.4375rem;
    fill: none;
    stroke: var(--color-brand-orange);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .commercial-card h3 {
    margin: 0;
    font-size: 1.3125rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .commercial-card p {
    max-width: 17.75rem;
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text-on-dark-muted);
  }

  .commercial-card a {
    position: absolute;
    bottom: 1.75rem;
    left: 1.125rem;
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-brand-orange);
    text-decoration: none;
  }

  .commercial-card a:hover,
  .commercial-card a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .commercial-cta {
    display: inline-flex;
    width: 100%;
    min-height: 3rem;
    margin-top: 1.5625rem;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 900;
    color: var(--color-on-dark);
    text-decoration: none;
    background: var(--color-action);
    border-radius: var(--radius-button);
  }

  .commercial-cta:hover,
  .commercial-cta:focus-visible {
    background: var(--color-action-hover);
  }

  @media (min-width: 64rem) {
    .commercial-roofing {
      min-height: 36.25rem;
    }

    .commercial-container {
      display: grid;
      grid-template-columns: 34.375rem 36.5625rem;
      gap: 9.0625rem;
      max-width: 80rem;
      padding: 5.625rem 0 0;
    }

    .section-eyebrow {
      font-size: 0.8125rem;
      letter-spacing: 0;
    }

    h2 {
      max-width: 32.5rem;
      margin-top: 0.9rem;
      font-size: 2.625rem;
    }

    .section-body {
      width: 35rem;
      max-width: 35rem;
      margin-top: 1.2rem;
      font-size: 1rem;
      line-height: 1.6;
    }

    .commercial-proof {
      min-height: 7.5rem;
      padding: 1.125rem 1.625rem;
      margin-top: 2.225rem;
    }

    .commercial-proof strong {
      font-size: 1.5rem;
    }

    .commercial-proof span {
      max-width: 30rem;
      margin-top: 0.625rem;
      font-size: 0.875rem;
    }

    .commercial-actions {
      padding-top: 0.5rem;
    }

    .commercial-card-grid {
      grid-template-columns: repeat(2, 17.5rem);
      gap: 1.5625rem;
      margin-top: 0;
    }

    .commercial-card {
      min-height: 18.75rem;
      padding: 5.3125rem 1.5625rem 1.5625rem;
    }

    .commercial-icon {
      top: 1.25rem;
      left: 1.5625rem;
      width: 3.125rem;
      height: 3.125rem;
    }

    .commercial-icon svg {
      width: 1.875rem;
      height: 1.875rem;
    }

    .commercial-card h3 {
      max-width: 13.75rem;
      font-size: 1.5625rem;
    }

    .commercial-card p {
      max-width: 14.375rem;
      margin-top: 1.1875rem;
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .commercial-card a {
      bottom: 2rem;
      left: 1.5625rem;
      font-size: 0.8125rem;
    }

    .mobile-arrow {
      display: none;
    }

    .commercial-cta {
      width: 17.5rem;
      min-height: 3.25rem;
      margin-top: 1.875rem;
    }
  }
</style>
