---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { createHeadingIds } from "../../../lib/heading-ids";

interface Props {
  items: ReadonlyArray<string>;
  image: ImageMetadata;
}

const { items, image } = Astro.props;
const heading = "Signs You May Need a Roof Repair";
const { sectionId, titleId } = createHeadingIds(heading);
---

<section
  id={sectionId}
  class="warning-signs"
  aria-labelledby={titleId}
  data-ui-id="roof-repair.warning-signs"
>
  <div class="warning-signs__container">
    <div class="warning-signs__visual">
      <Image
        src={image}
        width={720}
        height={640}
        widths={[360, 720, 1080]}
        sizes="(min-width: 81rem) 38rem, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2.5rem)"
        alt="Roofing professional checking lifted shingles and worn flashing around a roof vent"
        loading="lazy"
        decoding="async"
      />
      <div class="warning-signs__caption">
        <strong>Catch damage early</strong>
        <span>Protect the roof system beneath the surface.</span>
      </div>
    </div>

    <div class="warning-signs__copy">
      <div class="warning-signs__eyebrow">EARLY WARNING SIGNS</div>
      <h2 id={titleId}>{heading}</h2>
      <p class="warning-signs__intro">
        Roof issues often show early warning signs before major damage occurs.
        Look for changes outside and moisture symptoms inside your home.
      </p>

      <ul class="warning-signs__list">
        {
          items.map((item) => (
            <li>
              <span aria-hidden="true">✓</span>
              <strong>{item}</strong>
            </li>
          ))
        }
      </ul>

      <div class="warning-signs__alert">
        <span aria-hidden="true">!</span>
        <p>
          Active water intrusion?{" "}
          <a href="/affordable-roofing-services/roof-repair/roof-leak-repair/"
            >Visit our roof leak repair page</a
          > for immediate solutions.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .warning-signs {
    padding-block: 4.5rem;
    background: var(--color-surface-muted);
  }

  .warning-signs__container {
    display: grid;
    width: min(100% - 2.5rem, 80rem);
    gap: 2.75rem;
    margin-inline: auto;
  }

  .warning-signs__visual {
    position: relative;
    min-height: 20rem;
  }

  .warning-signs__visual :global(img) {
    width: 100%;
    height: 20rem;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .warning-signs__caption {
    position: absolute;
    right: 0.75rem;
    bottom: -1.25rem;
    left: 0.75rem;
    display: grid;
    min-height: 4.75rem;
    padding: 0.875rem 1rem;
    place-content: center start;
    color: var(--color-on-dark);
    background: var(--color-brand-blue);
    border-left: 0.375rem solid var(--color-brand-orange);
    border-radius: var(--radius-button);
    box-shadow: var(--shadow-nav);
  }

  .warning-signs__caption strong {
    font-family: var(--font-heading);
    font-size: 1rem;
  }

  .warning-signs__caption span {
    margin-top: 0.125rem;
    font-size: 0.6875rem;
    color: var(--color-text-on-dark-muted);
  }

  .warning-signs__copy {
    padding-top: 0.5rem;
  }

  .warning-signs__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--color-brand-orange);
  }

  h2 {
    margin: 0.875rem 0 0;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--color-brand-navy);
  }

  .warning-signs__intro {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .warning-signs__list {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 1.75rem 0 0;
    list-style: none;
  }

  .warning-signs__list li {
    display: flex;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.875rem 1rem;
    gap: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .warning-signs__list span {
    display: grid;
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    font-size: 0.75rem;
    color: var(--color-on-dark);
    background: var(--color-brand-orange);
    border-radius: 999px;
  }

  .warning-signs__list strong {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text-strong);
  }

  .warning-signs__alert {
    display: flex;
    align-items: flex-start;
    padding: 1rem;
    gap: 0.75rem;
    margin-top: 1.5rem;
    background: #fff4ed;
    border: 1px solid rgb(255 97 25 / 30%);
    border-radius: var(--radius-card);
  }

  .warning-signs__alert > span {
    display: grid;
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    font-weight: 900;
    color: var(--color-on-dark);
    background: var(--color-brand-orange);
    border-radius: 999px;
  }

  .warning-signs__alert p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .warning-signs__alert a {
    font-weight: 800;
    color: var(--color-brand-blue);
  }

  @media (min-width: 48rem) {
    .warning-signs {
      padding-block: 5rem;
    }

    .warning-signs__container {
      width: min(100% - 4rem, 48rem);
      gap: 3.5rem;
    }

    .warning-signs__visual,
    .warning-signs__visual :global(img) {
      min-height: 28rem;
      height: 28rem;
    }

    .warning-signs__caption {
      right: 1.5rem;
      left: 1.5rem;
      min-height: 5.5rem;
      padding-inline: 1.5rem;
    }

    .warning-signs__copy {
      max-width: 40rem;
    }

    h2 {
      font-size: 2.5rem;
    }

    .warning-signs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (min-width: 64rem) {
    .warning-signs__container {
      width: min(100% - 4rem, 64rem);
    }

    .warning-signs__copy {
      max-width: 56rem;
    }
  }

  @media (min-width: 81rem) {
    .warning-signs {
      padding-block: 7rem;
    }

    .warning-signs__container {
      width: min(100% - 3rem, 80rem);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 5rem;
    }

    .warning-signs__visual,
    .warning-signs__visual :global(img) {
      min-height: 42rem;
      height: 42rem;
    }

    .warning-signs__caption {
      right: -1.5rem;
      bottom: 2rem;
      left: auto;
      width: 19rem;
    }

    .warning-signs__copy {
      align-self: center;
      max-width: none;
      padding-top: 0;
    }

    h2 {
      max-width: 34rem;
      font-size: 3rem;
    }

    .warning-signs__intro {
      max-width: 35rem;
      font-size: 1rem;
    }
  }
</style>
