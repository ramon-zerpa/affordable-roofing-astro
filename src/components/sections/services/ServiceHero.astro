---
import type { ImageMetadata } from "astro";
import HomePathIcon from "../../icons/HomePathIcon.astro";

interface Props {
  croHeading: string;
  checkpoints: ReadonlyArray<string>;
  desktopImage: ImageMetadata;
  mobileImage: ImageMetadata;
  estimateHref: string;
  phoneHref: string;
  phoneDisplay: string;
}

const {
  croHeading,
  checkpoints,
  desktopImage,
  mobileImage,
  estimateHref,
  phoneHref,
  phoneDisplay,
} = Astro.props;
---

<section class="service-hero" aria-label="Tampa roof repair service">
  <picture class="service-hero__background" aria-hidden="true">
    <source media="(max-width: 63.9375rem)" srcset={mobileImage.src} />
    <img
      src={desktopImage.src}
      width={desktopImage.width}
      height={desktopImage.height}
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="service-hero__copy-wash"></div>

  <div class="service-hero__container">
    <div class="service-hero__copy">
      <nav class="service-hero__breadcrumbs" aria-label="Breadcrumb">
        <a href="/" aria-label="Home"><HomePathIcon name="home" /></a>
        <span aria-hidden="true">/</span>
        <a href="/affordable-roofing-services/">Roofing Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Roof Repair</span>
      </nav>

      <div class="service-hero__cro-heading">{croHeading}</div>

      <ul class="service-hero__checkpoints" aria-label="Roof repair benefits">
        {
          checkpoints.map((checkpoint) => (
            <li>
              <span aria-hidden="true">✓</span>
              <strong>{checkpoint}</strong>
            </li>
          ))
        }
      </ul>

      <div class="service-hero__actions">
        <a class="service-hero__estimate" href={estimateHref}
          >Get a FREE Estimate</a
        >
        <a class="service-hero__phone" href={phoneHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92Z"
            ></path>
          </svg>
          {phoneDisplay}
        </a>
      </div>

      <p class="service-hero__microcopy">
        Schedule your estimate and we’ll assess your roof’s condition and
        recommend the right repair.
      </p>
    </div>
  </div>
</section>

<style>
  .service-hero {
    position: relative;
    min-height: 45rem;
    overflow: hidden;
    color: var(--color-on-dark);
    background: var(--color-brand-navy);
  }

  .service-hero__background,
  .service-hero__background img,
  .service-hero__copy-wash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .service-hero__background img {
    object-fit: cover;
    object-position: 50% 0%;
  }

  .service-hero__copy-wash {
    background: linear-gradient(
      90deg,
      rgb(4 47 87 / 100%) 0%,
      rgb(4 47 87 / 50%) 100%
    );
  }

  .service-hero__container {
    position: relative;
    z-index: 3;
    width: 100%;
    min-height: inherit;
    padding: 1.5rem 1.25rem 3.75rem;
    margin-inline: auto;
  }

  .service-hero__breadcrumbs {
    display: flex;
    align-items: center;
    min-height: 2rem;
    gap: 0.5rem;
    margin-bottom: 0;
    font-size: 0.6875rem;
    font-weight: 800;
    color: rgb(255 255 255 / 75%);
  }

  .service-hero__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .service-hero__breadcrumbs a:first-child {
    width: 1rem;
  }

  .service-hero__copy {
    width: 100%;
    max-width: 21rem;
    margin-top: 3rem;
    margin-inline: auto;
  }

  .service-hero__cro-heading {
    max-width: 21rem;
    margin-top: 1.25rem;
    font-family: var(--font-heading);
    font-size: clamp(2.125rem, 10vw, 2.5rem);
    font-weight: 800;
    line-height: 1.02;
    color: var(--color-on-dark);
    text-wrap: balance;
  }

  .service-hero__checkpoints {
    display: grid;
    gap: 0.625rem;
    padding: 0;
    margin: 1.375rem 0 0;
    list-style: none;
  }

  .service-hero__checkpoints li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .service-hero__checkpoints span {
    display: grid;
    flex: 0 0 auto;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.0625rem;
    place-items: center;
    font-size: 0.6875rem;
    font-weight: 900;
    color: var(--color-on-dark);
    background: var(--color-brand-orange);
    border-radius: 999px;
  }

  .service-hero__checkpoints strong {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-on-dark);
  }

  .service-hero__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .service-hero__estimate,
  .service-hero__phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding-inline: 1rem;
    font-size: 0.875rem;
    font-weight: 900;
    color: var(--color-on-dark);
    text-decoration: none;
    border-radius: var(--radius-button);
  }

  .service-hero__estimate {
    background: var(--color-action);
  }

  .service-hero__phone {
    gap: 0.5rem;
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 80%);
  }

  .service-hero__phone svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .service-hero__microcopy {
    margin: 2rem 0 0;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.45;
    color: rgb(255 255 255 / 76%);
  }

  .service-hero__estimate:hover,
  .service-hero__estimate:focus-visible {
    background: var(--color-action-hover);
  }

  .service-hero__phone:hover,
  .service-hero__phone:focus-visible {
    background: rgb(255 255 255 / 18%);
  }

  @media (min-width: 48rem) {
    .service-hero {
      min-height: 42rem;
    }

    .service-hero__container {
      max-width: 48rem;
      padding: 2rem 2rem 4rem;
    }

    .service-hero__copy {
      max-width: 40rem;
      margin-inline: 0;
    }

    .service-hero__cro-heading,
    .service-hero__checkpoints,
    .service-hero__actions,
    .service-hero__microcopy {
      width: 100%;
      max-width: 40rem;
    }

    .service-hero__cro-heading {
      font-size: 3rem;
    }

    .service-hero__checkpoints {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.625rem;
    }

    .service-hero__checkpoints strong,
    .service-hero__microcopy {
      white-space: nowrap;
    }
  }

  @media (min-width: 64rem) {
    .service-hero__container {
      max-width: 64rem;
    }

    .service-hero__copy,
    .service-hero__cro-heading,
    .service-hero__checkpoints,
    .service-hero__actions,
    .service-hero__microcopy {
      max-width: 56rem;
    }

    .service-hero__actions {
      grid-template-columns: repeat(2, minmax(0, 13rem));
      gap: 1.25rem;
    }
  }

  @media (min-width: 81rem) {
    .service-hero {
      min-height: 47rem;
    }

    .service-hero__background img {
      object-position: 50% 0%;
    }

    .service-hero__copy-wash {
      background: linear-gradient(
        90deg,
        rgb(4 47 87 / 100%) 0%,
        rgb(4 47 87 / 50%) 100%
      );
    }

    .service-hero__container {
      max-width: 80rem;
      padding: 9.75rem 0 4.5rem;
    }

    .service-hero__breadcrumbs {
      font-size: 0.75rem;
    }

    .service-hero__copy {
      max-width: 46rem;
    }

    .service-hero__eyebrow {
      display: inline-flex;
      align-items: center;
      min-height: 2.625rem;
      padding-inline: 1.25rem;
      font-size: 0.875rem;
      background: var(--color-surface);
      border-radius: 999px;
    }

    .service-hero__cro-heading {
      max-width: 45rem;
      margin-top: 1.375rem;
      font-size: 3.5rem;
    }

    .service-hero__actions {
      max-width: 28rem;
    }

    .service-hero__microcopy {
      max-width: 34rem;
      font-size: 0.75rem;
    }

    .service-hero__checkpoints {
      max-width: 45rem;
      gap: 0.625rem 2rem;
    }

    .service-hero__checkpoints strong {
      font-size: 0.8125rem;
    }
  }
</style>
