---
import type { ImageMetadata } from "astro";
import LiteYouTubeEmbed from "../../media/LiteYouTubeEmbed.astro";
import { createHeadingIds } from "../../../lib/heading-ids";

interface Props {
  heading: string;
  paragraphs: ReadonlyArray<string>;
  videoId: string;
  videoTitle: string;
  videoPoster: ImageMetadata;
}

const { heading, paragraphs, videoId, videoTitle, videoPoster } = Astro.props;
const { sectionId, titleId } = createHeadingIds(heading);
---

<section
  id={sectionId}
  class="service-introduction"
  aria-labelledby={titleId}
  data-ui-id="roof-repair.introduction"
>
  <div class="service-introduction__container">
    <div class="service-introduction__grid">
      <div class="service-introduction__media">
        <LiteYouTubeEmbed
          videoId={videoId}
          title={videoTitle}
          poster={videoPoster}
        />
      </div>

      <div class="service-introduction__content">
        <div class="service-introduction__eyebrow">
          LOCAL ROOF REPAIR EXPERTS
        </div>
        <h1 id={titleId}>{heading}</h1>
        <div class="service-introduction__copy">
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .service-introduction {
    padding-block: 4rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .service-introduction__container {
    width: min(100% - 2.5rem, 80rem);
    margin-inline: auto;
  }

  .service-introduction__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.14em;
    color: var(--color-brand-orange);
  }

  .service-introduction__grid {
    display: grid;
    gap: 3rem;
  }

  .service-introduction__media {
    width: 90%;
    align-self: center;
    justify-self: start;
  }

  h1 {
    margin: 0.875rem 0 0;
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.05;
    color: var(--color-brand-navy);
  }

  .service-introduction__copy {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.25rem;
  }

  .service-introduction__copy p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (min-width: 48rem) {
    .service-introduction {
      padding-block: 5rem;
    }

    .service-introduction__container {
      width: min(100% - 4rem, 48rem);
    }

    .service-introduction__grid {
      gap: 3.5rem;
    }

    h1 {
      font-size: 3rem;
    }
  }

  @media (min-width: 64rem) {
    .service-introduction__container {
      width: min(100% - 4rem, 64rem);
    }

    .service-introduction__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 3.5rem;
    }

    h1 {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 81rem) {
    .service-introduction {
      padding-block: 6rem;
    }

    .service-introduction__container {
      width: min(100% - 3rem, 80rem);
    }

    .service-introduction__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 3rem;
    }

    h1 {
      font-size: 3.5rem;
    }

    .service-introduction__copy {
      padding-left: 1.5rem;
      margin-top: 1.5rem;
      border-left: 0.25rem solid var(--color-brand-orange);
    }

    .service-introduction__copy p {
      font-size: 1rem;
    }
  }
</style>
