---
import logo from "../../assets/images/ars-logo.webp";
import { primaryNavigation, site } from "../../data/site";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="site-header">
  <div class="utility-bar">
    <div class="utility-inner">
      <p>{t("site.tagline")}</p>
      <div class="utility-actions">
        <a href={site.phoneHref}>{t("site.phoneDisplay")}</a>
        <a class="utility-estimate" href={site.estimateHref}
          >{t("site.estimate")}</a
        >
      </div>
    </div>
  </div>

  <div class="navigation-shell">
    <nav class="primary-navigation" aria-label={t("nav.label")}>
      <a class="brand" href="/" aria-label={t("site.name")}>
        <img
          src={logo.src}
          width={logo.width}
          height={logo.height}
          alt={t("site.name")}
          decoding="async"
        />
      </a>

      <div class="desktop-navigation">
        {
          primaryNavigation.map((item) => (
            <a href={item.href}>{t(item.labelKey)}</a>
          ))
        }
      </div>

      <a class="header-estimate" href={site.estimateHref}
        >{t("site.estimateShort")}</a
      >

      <details class="mobile-navigation">
        <summary aria-label={t("a11y.openMenu")}>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </summary>
        <div class="mobile-navigation-panel">
          {
            primaryNavigation.map((item) => (
              <a href={item.href}>{t(item.labelKey)}</a>
            ))
          }
          <a class="mobile-estimate" href={site.estimateHref}
            >{t("site.estimate")}</a
          >
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .utility-bar {
    order: 2;
    height: 2rem;
    color: var(--color-on-dark);
    background: var(--color-brand-navy);
  }

  .utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding-inline: 1.125rem;
    margin-inline: auto;
  }

  .utility-inner p,
  .utility-actions a {
    margin: 0;
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .utility-actions {
    display: flex;
    align-items: center;
  }

  .utility-actions a {
    font-weight: 800;
  }

  .utility-estimate {
    display: none;
  }

  .navigation-shell {
    order: 1;
    height: 4.5rem;
    background: var(--color-surface);
  }

  .primary-navigation {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding-inline: 0.875rem;
  }

  .brand {
    display: grid;
    width: 8.125rem;
    height: 3.25rem;
    place-items: center;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .brand img {
    width: 7.375rem;
    height: 2.875rem;
    object-fit: contain;
  }

  .desktop-navigation,
  .header-estimate {
    display: none;
  }

  .mobile-navigation {
    position: static;
  }

  .mobile-navigation summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 2.75rem;
    gap: 0.25rem;
    cursor: pointer;
    list-style: none;
    background: var(--color-brand-blue);
    border-radius: var(--radius-button);
  }

  .mobile-navigation summary::-webkit-details-marker {
    display: none;
  }

  .mobile-navigation summary span {
    display: block;
    width: 1.375rem;
    height: 0.125rem;
    background: var(--color-on-dark);
    border-radius: 999px;
  }

  .mobile-navigation-panel {
    position: absolute;
    top: 4.5rem;
    right: 0;
    left: 0;
    display: grid;
    gap: 0;
    padding: 0.75rem 1.25rem 1.25rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: var(--shadow-nav);
  }

  .mobile-navigation-panel a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-text-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-navigation-panel .mobile-estimate {
    justify-content: center;
    min-height: 3rem;
    margin-top: 0.875rem;
    color: var(--color-on-dark);
    background: var(--color-action);
    border: 0;
    border-radius: var(--radius-button);
  }

  @media (min-width: 64rem) {
    .site-header {
      position: absolute;
      top: 0;
      left: 0;
    }

    .utility-bar {
      order: 1;
      height: 2.625rem;
    }

    .utility-inner {
      max-width: 80rem;
      padding-inline: 0;
    }

    .utility-inner p,
    .utility-actions a {
      font-size: 0.8125rem;
    }

    .utility-actions {
      gap: 1.75rem;
    }

    .utility-estimate {
      display: inline-flex;
      color: var(--color-brand-orange) !important;
    }

    .navigation-shell {
      order: 2;
      height: 6.75rem;
      padding-top: 1rem;
      background: transparent;
    }

    .primary-navigation {
      max-width: 80rem;
      height: 5.75rem;
      padding-inline: 1.5rem;
      margin-inline: auto;
      background: var(--color-surface);
      border: 1px solid rgb(255 255 255 / 40%);
      border-radius: var(--radius-card);
    }

    .brand {
      width: 9.625rem;
      height: 4.25rem;
    }

    .brand img {
      width: 8.75rem;
      height: 3.75rem;
    }

    .desktop-navigation {
      display: flex;
      align-items: center;
      gap: clamp(0.75rem, 1.45vw, 1.375rem);
      margin-left: 2rem;
    }

    .desktop-navigation a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      font-size: 0.8125rem;
      font-weight: 800;
      line-height: 1;
      color: var(--color-text-strong);
      text-decoration: none;
      white-space: nowrap;
    }

    .desktop-navigation a:hover,
    .desktop-navigation a:focus-visible {
      color: var(--color-brand-blue);
    }

    .header-estimate {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 9.6875rem;
      min-height: 3.25rem;
      margin-left: auto;
      font-size: 0.875rem;
      font-weight: 900;
      color: var(--color-on-dark);
      text-decoration: none;
      background: var(--color-action);
      border-radius: var(--radius-button);
    }

    .mobile-navigation {
      display: none;
    }
  }
</style>
