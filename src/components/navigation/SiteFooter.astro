---
import footerLogo from "../../assets/images/ars-logo-footer-white.png";
import { footerNavigation, footerServices, site } from "../../data/site";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const ratingText = `${t("footer.ratingPrefix")} ${site.rating.value} ${t("footer.ratingOutOf")} ${site.rating.best} ${t("footer.ratingBasedOn")} ${site.rating.reviewCount} ${t("footer.ratingReviews")}`;

const socialLinks = [
  {
    label: "Facebook",
    href: site.social.facebook,
    path: "M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3.6l.4-4h-4V7a1 1 0 0 1 1-1h3V2Z",
  },
  {
    label: "Instagram",
    href: site.social.instagram,
    path: "M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9Zm4.5 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-2.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z",
  },
  {
    label: "X",
    href: site.social.x,
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z",
  },
  {
    label: "LinkedIn",
    href: site.social.linkedin,
    path: "M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9.5h4v12H3v-12Zm6.5 0h3.8v1.65h.06c.53-1 1.82-2.05 3.74-2.05 4 0 4.74 2.63 4.74 6.05v6.35h-4v-5.63c0-1.34-.02-3.07-1.87-3.07s-2.16 1.46-2.16 2.97v5.73h-4v-12Z",
  },
  {
    label: "YouTube",
    href: site.social.youtube,
    path: "M23.5 6.2a3 3 0 0 0-2.1-2.12C19.54 3.6 12 3.6 12 3.6s-7.54 0-9.4.48A3 3 0 0 0 .5 6.2 31.1 31.1 0 0 0 0 12a31.1 31.1 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.12c1.86.48 9.4.48 9.4.48s7.54 0 9.4-.48a3 3 0 0 0 2.1-2.12A31.1 31.1 0 0 0 24 12a31.1 31.1 0 0 0-.5-5.8ZM9.75 15.5v-7l6.2 3.5-6.2 3.5Z",
  },
] as const;
---

<footer class="site-footer" data-ui-id="global.footer">
  <div class="footer-shell">
    <div class="footer-brand" data-ui-id="global.footer.brand">
      <a href="/" aria-label={site.name}>
        <img
          src={footerLogo.src}
          width={footerLogo.width}
          height={footerLogo.height}
          alt={site.name}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>{t("footer.tagline")}</p>
    </div>

    <div class="footer-cta" data-ui-id="global.footer.cta">
      <p>{t("footer.cta")}</p>
      <a href={site.estimateHref}>{t("footer.ctaButton")}</a>
    </div>

    <section
      class="footer-contact footer-column"
      aria-labelledby="footer-contact-title"
      data-ui-id="global.footer.contact"
    >
      <h2 id="footer-contact-title">{t("footer.contact")}</h2>
      <address>
        <a href={site.address.mapHref} target="_blank" rel="noreferrer">
          {site.address.street}<br />
          {site.address.locality}, Florida {site.address.postalCode}
        </a>
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
        <span>{t("footer.fax")}: {site.faxDisplay}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </section>

    <div class="footer-link-columns">
      <nav
        class="footer-column"
        aria-labelledby="footer-navigation-title"
        data-ui-id="global.footer.navigation"
      >
        <h2 id="footer-navigation-title">{t("footer.navigation")}</h2>
        <ul>
          {
            footerNavigation.map((item) => (
              <li>
                <a href={item.href}>{t(item.labelKey)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav
        class="footer-column"
        aria-labelledby="footer-services-title"
        data-ui-id="global.footer.services"
      >
        <h2 id="footer-services-title">{t("footer.popularServices")}</h2>
        <ul>
          {
            footerServices.map((item) => (
              <li>
                <a href={item.href}>{t(item.labelKey)}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer-meta" data-ui-id="global.footer.bottom">
      <div
        class="footer-rating"
        aria-label={`${t("footer.ratingA11y")}: ${ratingText}`}
      >
        <strong>{site.legalName}</strong>
        <span class="rating-stars" aria-hidden="true">★★★★☆</span>
        <small>{ratingText}</small>
      </div>

      <nav class="footer-social" aria-label={t("footer.socialLabel")}>
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              target="_blank"
              rel="noreferrer"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d={social.path} />
              </svg>
            </a>
          ))
        }
      </nav>

      <div class="footer-legal">
        <p>{t("footer.copyright")} © {currentYear} {site.name}</p>
        <div>
          <a href="/terms-conditions/">{t("footer.terms")}</a>
          <a href="/privacy-policy/">{t("footer.privacy")}</a>
        </div>
      </div>

      <p class="footer-credit">
        {t("footer.designBy")}
        <a
          href="https://www.truewebmaster.com/"
          target="_blank"
          rel="noreferrer">True Webmaster</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    min-height: 73.75rem;
    color: var(--color-text-on-dark-muted);
    background: var(--color-ink-950);
  }

  .footer-shell {
    display: grid;
    width: min(100% - 2.5rem, 80rem);
    padding-block: 2.8125rem 2.25rem;
    margin-inline: auto;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--color-brand-orange);
  }

  .footer-brand {
    grid-row: 1;
  }

  .footer-brand > a {
    display: block;
    width: 9.375rem;
    height: 5rem;
  }

  .footer-brand img {
    width: 9.375rem;
    height: 5rem;
    object-fit: contain;
    object-position: left center;
  }

  .footer-brand p {
    max-width: 19.6875rem;
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    color: #cbd5e1;
  }

  .footer-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: 8.5rem;
    padding: 1rem 1.125rem;
    margin-top: 2.875rem;
    color: var(--color-on-dark);
    background: var(--color-brand-orange);
    border-radius: var(--radius-card);
  }

  .footer-cta p {
    max-width: 17.75rem;
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 900;
    line-height: 1.25;
  }

  .footer-cta a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 8.625rem;
    min-height: 2.625rem;
    padding-inline: 1rem;
    margin-top: 1rem;
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-brand-orange);
    background: var(--color-surface);
    border-radius: var(--radius-button);
  }

  .footer-cta a:hover,
  .footer-cta a:focus-visible {
    color: var(--color-brand-navy);
  }

  .footer-column h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.3125rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-on-dark);
  }

  .footer-contact {
    margin-top: 2.75rem;
  }

  .footer-contact address,
  .footer-column ul {
    margin: 1rem 0 0;
    padding: 0;
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 500;
    line-height: 1.72;
    list-style: none;
  }

  .footer-contact address {
    display: grid;
  }

  .footer-contact address > * {
    width: fit-content;
  }

  .footer-link-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .footer-column li + li {
    margin-top: 0.0625rem;
  }

  .footer-meta {
    display: grid;
    margin-top: 3rem;
  }

  .footer-rating {
    display: grid;
    justify-items: start;
    color: var(--color-on-dark);
  }

  .footer-rating strong {
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .rating-stars {
    margin-top: 0.375rem;
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: 0.0625rem;
    color: var(--color-brand-orange);
  }

  .footer-rating small {
    max-width: 17rem;
    margin-top: 0.375rem;
    font-size: 0.6875rem;
    line-height: 1.55;
    color: #cbd5e1;
  }

  .footer-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.625rem;
  }

  .footer-social a {
    display: grid;
    width: 2.125rem;
    height: 2.125rem;
    place-items: center;
    color: var(--color-on-dark);
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 50%;
  }

  .footer-social a:hover,
  .footer-social a:focus-visible {
    color: var(--color-on-dark);
    background: var(--color-brand-orange);
  }

  .footer-social svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentcolor;
  }

  .footer-legal {
    margin-top: 2.125rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #9ca3af;
  }

  .footer-legal p,
  .footer-credit {
    margin: 0;
  }

  .footer-legal > div {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .footer-credit {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #9ca3af;
  }

  .footer-credit a {
    margin-left: 0.25rem;
    font-weight: 800;
    color: var(--color-brand-orange);
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .site-footer {
      min-height: auto;
    }

    .footer-shell {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 3rem;
      width: min(100% - 4rem, 46rem);
      padding-block: 4rem 3rem;
    }

    .footer-brand {
      grid-row: 1;
      grid-column: 1;
    }

    .footer-contact {
      grid-row: 1;
      grid-column: 2;
      margin-top: 0;
    }

    .footer-cta {
      flex-direction: row;
      grid-row: 2;
      grid-column: 1 / -1;
      align-items: center;
      justify-content: space-between;
      min-height: 5rem;
      padding-inline: 1.5rem;
      margin-top: 0;
    }

    .footer-cta p {
      max-width: none;
      font-size: 1.25rem;
    }

    .footer-cta a {
      margin-top: 0;
    }

    .footer-link-columns {
      grid-row: 3;
      grid-column: 1 / -1;
      gap: 3rem;
      margin-top: 0;
    }

    .footer-meta {
      grid-row: 4;
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 3rem;
      padding-top: 1.5rem;
      margin-top: 0;
    }

    .footer-social {
      justify-content: end;
      margin-top: 0;
    }

    .footer-legal {
      margin-top: 0;
    }

    .footer-credit {
      align-self: end;
      margin-top: 0;
      text-align: right;
    }
  }

  @media (min-width: 81rem) {
    .site-footer {
      min-height: 35.625rem;
    }

    .footer-shell {
      grid-template-rows: 15.9375rem 4.6875rem auto;
      grid-template-columns: 20.9375rem 5.625rem 13.75rem 6.5625rem 11.25rem 3.75rem 11.25rem 1fr;
      width: min(100% - 4rem, 80rem);
      min-height: 35.625rem;
      padding-block: 4.375rem 2.5rem;
    }

    .footer-brand {
      grid-row: 1;
      grid-column: 1;
      padding-top: 0.3125rem;
      margin-left: 1.25rem;
    }

    .footer-brand p {
      max-width: 20.625rem;
      margin-top: 1.875rem;
      font-size: 0.875rem;
    }

    .footer-contact {
      grid-row: 1;
      grid-column: 3;
      margin-top: 0;
    }

    .footer-link-columns {
      display: grid;
      grid-row: 1;
      grid-column: 5 / 8;
      grid-template-columns: 11.25rem 3.75rem 11.25rem;
      gap: 0;
      margin-top: 0;
    }

    .footer-link-columns > :first-child {
      grid-column: 1;
    }

    .footer-link-columns > :last-child {
      grid-column: 3;
    }

    .footer-column h2 {
      font-size: 1.25rem;
    }

    .footer-contact address,
    .footer-column ul {
      margin-top: 1rem;
      font-size: 0.8125rem;
      line-height: 1.75;
    }

    .footer-cta {
      flex-direction: row;
      grid-row: 2;
      grid-column: 1 / -1;
      align-items: center;
      justify-content: space-between;
      min-height: 4.6875rem;
      padding-inline: 2rem;
      margin-top: 0;
    }

    .footer-cta p {
      max-width: none;
      font-size: 1.375rem;
    }

    .footer-cta a {
      min-width: 8.625rem;
      margin-top: 0;
    }

    .footer-meta {
      display: grid;
      grid-row: 3;
      grid-column: 1 / -1;
      grid-template-rows: 2.125rem 2.125rem;
      grid-template-columns: 1fr 1fr 1fr;
      align-items: start;
      min-height: 5.625rem;
      padding: 0.875rem 0.625rem 0;
      margin-top: 2.5rem;
    }

    .footer-rating {
      grid-row: 1 / 3;
      grid-column: 2;
      justify-items: center;
    }

    .rating-stars {
      margin-top: 0.125rem;
      font-size: 1.0625rem;
    }

    .footer-rating small {
      max-width: none;
      margin-top: 0.125rem;
      font-size: 0.625rem;
    }

    .footer-social {
      grid-row: 1;
      grid-column: 3;
      justify-content: end;
      margin-top: 0;
    }

    .footer-legal {
      display: grid;
      grid-row: 1 / 3;
      grid-column: 1;
      grid-template-rows: 2.125rem 2.125rem;
      margin-top: 0;
      font-size: 0.75rem;
    }

    .footer-legal > div {
      gap: 1.5rem;
      margin-top: 0;
    }

    .footer-credit {
      grid-row: 2;
      grid-column: 3;
      align-self: center;
      margin-top: 0;
      font-size: 0.75rem;
      text-align: right;
    }
  }
</style>
