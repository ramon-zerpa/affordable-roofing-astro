---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  videoId: string;
  title: string;
  poster: ImageMetadata;
}

const { videoId, title, poster } = Astro.props;
const youtubeUrl = `https://www.youtube.com/watch?v=${videoId}`;
---

<div
  class="lite-youtube"
  data-lite-youtube
  data-video-id={videoId}
  data-video-title={title}
>
  <Image
    class="lite-youtube__poster"
    src={poster}
    width={1280}
    height={720}
    widths={[360, 720, 1280]}
    sizes="(min-width: 64rem) 40vw, (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2.5rem)"
    alt="Roof repair video showing a roofing professional working on asphalt shingles"
    loading="lazy"
    decoding="async"
  />
  <button
    class="lite-youtube__button"
    type="button"
    aria-label={`Play ${title}`}
  >
    <span class="lite-youtube__play" aria-hidden="true">
      <svg viewBox="0 0 28 32">
        <path d="M28 16 0 32V0z"></path>
      </svg>
    </span>
  </button>
  <noscript>
    <a href={youtubeUrl} rel="noopener noreferrer">Watch {title} on YouTube</a>
  </noscript>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-lite-youtube]")
    .forEach((player) => {
      if (player.dataset.enhanced === "true") return;

      const button = player.querySelector<HTMLButtonElement>("button");
      const videoId = player.dataset.videoId;
      const title = player.dataset.videoTitle ?? "Roof repair video";

      if (!button || !videoId) return;
      player.dataset.enhanced = "true";

      button.addEventListener(
        "click",
        () => {
          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`;
          iframe.title = title;
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.referrerPolicy = "strict-origin-when-cross-origin";
          iframe.allowFullscreen = true;
          iframe.setAttribute("loading", "lazy");

          player.replaceChildren(iframe);
          player.classList.add("is-playing");
        },
        { once: true },
      );
    });
</script>

<style>
  .lite-youtube {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-ink-950);
    border-radius: var(--radius-card);
    box-shadow: 0 1.5rem 3.5rem rgb(4 47 87 / 18%);
  }

  .lite-youtube :global(.lite-youtube__poster),
  .lite-youtube :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lite-youtube :global(.lite-youtube__poster) {
    object-fit: cover;
  }

  .lite-youtube__button {
    position: absolute;
    inset: 0;
    display: grid;
    width: 100%;
    height: 100%;
    padding: 0;
    cursor: pointer;
    place-items: center;
    background: rgb(4 47 87 / 12%);
    border: 0;
  }

  .lite-youtube__button::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(180deg, transparent 45%, rgb(4 47 87 / 24%));
  }

  .lite-youtube__play {
    position: relative;
    z-index: 1;
    display: grid;
    width: 4.5rem;
    height: 4.5rem;
    place-items: center;
    color: var(--color-on-dark);
    background: var(--color-action);
    border: 0.25rem solid rgb(255 255 255 / 85%);
    border-radius: 999px;
    box-shadow: 0 0.75rem 2rem rgb(9 14 24 / 35%);
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .lite-youtube__play svg {
    width: 1.25rem;
    height: 1.5rem;
    margin-left: 0.25rem;
    fill: currentColor;
  }

  .lite-youtube__button:hover .lite-youtube__play,
  .lite-youtube__button:focus-visible .lite-youtube__play {
    background: var(--color-action-hover);
    transform: scale(1.06);
  }

  .lite-youtube.is-playing {
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lite-youtube__play {
      transition: none;
    }
  }
</style>
