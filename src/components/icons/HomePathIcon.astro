---
import type { HomePathIcon } from "../../data/home";

interface Props {
  name: HomePathIcon;
}

const { name } = Astro.props;
---

<svg
  class="home-path-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "home" && (
      <>
        <path d="m3 11 9-8 9 8" />
        <path d="M5 10v10h14V10" />
        <path d="M9 20v-6h6v6" />
      </>
    )
  }
  {
    name === "repair" && (
      <>
        <path d="M14.5 5.5 18 9l-8.5 8.5H6V14z" />
        <path d="m13 7 3 3" />
        <path d="M5 19h14" />
      </>
    )
  }
  {
    name === "shingle" && (
      <>
        <path d="M5 8h14M5 12h14M5 16h14" />
        <path d="M7 8v8M12 8v8M17 8v8" />
      </>
    )
  }
  {
    name === "commercial" && (
      <>
        <path d="M3 21h18" />
        <path d="M6 21V7l6-4 6 4v14" />
        <path d="M9 9h6M9 13h6" />
        <path d="M10 21v-4h4v4" />
      </>
    )
  }
</svg>

<style>
  .home-path-icon {
    width: 100%;
    height: 100%;
  }
</style>
